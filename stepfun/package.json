{
  "name": "stepfun-edge-kb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "postinstall": "node scripts/runtime.mjs",
    "models:download": "node scripts/models.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:status": "node scripts/db.mjs status"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "express": "5.1.0",
    "seekdb": "1.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.8"
  }
}
