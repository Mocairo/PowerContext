# LabRelay application
LABRELAY_ENV=development
LABRELAY_API_BIND_ADDRESS=127.0.0.1
LABRELAY_API_PORT=8010
LABRELAY_WEB_PORT=5173
LABRELAY_API_ORIGIN=http://127.0.0.1:8010
LABRELAY_DATA_ROOT=./data

# Offline demo run. Set to 1 to replace seekdb, PowerContext and the model gateways with the
# in-memory and deterministic stand-ins, so the whole flow runs with no database and no API key.
# Leave unset for the real stack. Never ship a deployment that relies on this being 1.
LABRELAY_USE_FAKE_DEPS=0

# seekdb integration tests. Unset means those tests skip; see docs/operations/seekdb.md.
# LABRELAY_SEEKDB_TEST=1
# LABRELAY_SEEKDB_TEST_DATABASE=labrelay_test

# seekdb container and application connection
SEEKDB_IMAGE=oceanbase/seekdb:latest
SEEKDB_SQL_PORT=2881
SEEKDB_RPC_PORT=2886
SEEKDB_ROOT_PASSWORD=replace-with-a-strong-local-password
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_DATABASE=labrelay
SEEKDB_USER=root

# PowerContext Server
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_MCP_URL=http://127.0.0.1:8000/mcp
POWERCONTEXT_DASHBOARD_URL=http://127.0.0.1:8000/dashboard/home
POWERCONTEXT_TOKEN=

# Generation model
GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_API_KEY=replace-with-a-secret-store-value
GENERATION_MODEL=replace-with-generation-model

# Embedding model
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-a-secret-store-value
EMBEDDING_MODEL=replace-with-embedding-model
EMBEDDING_DIMENSIONS=1024

# Composition switches (see docs/operations/run-guide.md sections 3.2 and 3.3)
# Leave these unset to use the run mode's defaults; set one only when composing a mixed stack.
# memory | seekdb
# LABRELAY_REPOSITORY=memory
# memory | powercontext
# LABRELAY_CONTEXT=powercontext
# deterministic | openai_compat | qoder
# LABRELAY_MODEL_PROVIDER=qoder
# Qoder built-in Qwen; sign in with `qodercli login` first
# qfmodel = Qwen3.8-Flash (catalog key; list with the SDK/CLI)
LABRELAY_MODEL=qfmodel
LABRELAY_QODER_TIMEOUT=120
LABRELAY_EMBEDDING_DIMENSIONS=256
# QODER_PERSONAL_ACCESS_TOKEN is intentionally absent: set it in your own shell.
